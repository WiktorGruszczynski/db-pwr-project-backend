# Szablon zmiennych dla Docker Compose. Skopiuj do .env (obok docker-compose.yml):
#   cp .env.docker.example .env
#
# Compose automatycznie wczytuje .env z tego katalogu. Wszystkie zmienne mają
# sensowne wartości domyślne — plik .env jest opcjonalny. Baza działa w kontenerze,
# więc DB_HOST nie podajemy (backend zawsze łączy się z usługą "db").

# ── Baza danych ────────────────────────────────────────────────
DB_NAME=food_db_pwr
DB_USER=postgres
DB_PASS=admin

# ── Poczta (2FA / reset hasła) ─────────────────────────────────
# Bez tych zmiennych rejestracja działa, ale mail z kodem się nie wyśle.
SMTP_USERNAME=
SMTP_PASSWORD=
